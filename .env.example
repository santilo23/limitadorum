# Copiar a .env y completar. El archivo .env esta en .gitignore: NO se versiona,
# asi que es el lugar correcto para la contrasena.
#
#   cp .env.example .env

# --- Conexion de la aplicacion (lo lee boot.ps1) ---
# Apuntar al PostgreSQL del sistema (pgAdmin, puerto 5432) o al contenedor
# (puerto 5433), segun contra cual se quiera trabajar.
DB_URL=jdbc:postgresql://localhost:5432/USERS_AUTH_DEV
DB_USER=postgres
DB_PASSWORD=

# --- Contenedor de docker-compose ---
# Nombre de la base que se crea la primera vez que arranca el contenedor.
DB_NAME=USERS_AUTH_DEV
# Puerto del HOST que se mapea al 5432 del contenedor. Se usa 5433 porque el
# 5432 lo ocupa el PostgreSQL instalado en el sistema.
DB_PORT=5433
