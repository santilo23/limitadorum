# Copiar a .env y ajustar segun el entorno local.
# docker-compose lee este archivo automaticamente si se llama .env

DB_NAME=limitadorum
DB_USER=postgres
DB_PASSWORD=postgres

# Puerto del HOST que se mapea al 5432 del contenedor.
# Cambialo si ya tenes un PostgreSQL instalado ocupando el 5432.
DB_PORT=5432
